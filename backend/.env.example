# Copy to .env (git-ignored). Names only; never commit real values.
SPX_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SPX_LOG_LEVEL=INFO
SPX_DATA_DIR=data
# Serve a built frontend folder at "/" (optional). Example: ../frontend
# SPX_FRONTEND_DIR=
SPX_SIA_COLLECTIONS=spherex_dr1,spherex_dr1_deep,spherex_qr3,spherex_qr3_deep
# LLM providers (decision D-1: Gemini first):
SPX_LLM_PROVIDER_1=gemini
SPX_LLM_API_KEY_1=
# Gemini model: pick one that has free quota in your AI Studio console
SPX_LLM_MODEL_1=gemini-flash-lite-latest
# Backup providers, tried in order if the one above fails or is slow. Each Gemini model has its own free quota, so the same key
# can serve all three. Providers 2 and 3 use the same names with _2 / _3. "gemini" or "openai_compatible" (needs a base URL).
SPX_LLM_PROVIDER_2=gemini
SPX_LLM_API_KEY_2=
SPX_LLM_MODEL_2=gemini-3.5-flash-lite
SPX_LLM_PROVIDER_3=gemini
SPX_LLM_API_KEY_3=
SPX_LLM_MODEL_3=gemini-3.1-flash-lite
# Free-tier protection. Free tiers allow roughly 10 to 15 requests a minute: check your models' real limits in Google AI Studio.
SPX_CHAT_LIMIT_PER_CLIENT=60
SPX_CHAT_LIMIT_GLOBAL_DAILY=1500
SPX_CHAT_LIMIT_PER_MINUTE=10
