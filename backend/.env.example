# Copy to .env (git-ignored). Names only; never commit real values.
SPX_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SPX_LOG_LEVEL=INFO
SPX_DATA_DIR=data
# Serve a built frontend folder at "/" (optional). Example: ../frontend
# SPX_FRONTEND_DIR=
SPX_SIA_COLLECTIONS=spherex_dr1,spherex_dr1_deep,spherex_qr3,spherex_qr3_deep
