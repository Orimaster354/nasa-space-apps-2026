# Copy to .env (git-ignored). Names only; never commit real values.
SPX_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SPX_LOG_LEVEL=INFO
SPX_DATA_DIR=data
# Serve a built frontend folder at "/" (optional). Example: ../frontend
# SPX_FRONTEND_DIR=
SPX_SIA_COLLECTIONS=spherex_dr1,spherex_dr1_deep,spherex_qr3,spherex_qr3_deep
# LLM providers (decision D-1: Gemini first):
SPX_LLM_PROVIDER_1=gemini
SPX_LLM_API_KEY_1=
# Gemini model: pick one that has free quota in your AI Studio console
SPX_LLM_MODEL_1=
# Optional second provider, tried if the first fails ("gemini" or "openai_compatible"; the latter needs a base URL)
# SPX_LLM_PROVIDER_2=
# SPX_LLM_API_KEY_2=
# SPX_LLM_MODEL_2=
# SPX_LLM_BASE_URL_2=
# Free-tier protection: AI messages per visitor, and per day for the whole site. After that: automated summaries.
SPX_CHAT_LIMIT_PER_CLIENT=15
SPX_CHAT_LIMIT_GLOBAL_DAILY=500
